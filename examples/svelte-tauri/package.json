{
  "name": "@tauri-ui-inspector/example-svelte-tauri",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @tauri-ui-inspector/adapter-svelte build",
    "build": "tauri build --debug --no-bundle",
    "prebuild:web": "pnpm --filter @tauri-ui-inspector/adapter-svelte build",
    "build:web": "vite build",
    "precheck": "pnpm --filter @tauri-ui-inspector/adapter-svelte build",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "predev": "pnpm --filter @tauri-ui-inspector/adapter-svelte build",
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "e2e": "pnpm e2e:build && start-test e2e:web http://127.0.0.1:1420 e2e:run",
    "e2e:build": "pnpm --filter @tauri-ui-inspector/adapter-svelte build && cargo build -p tauri-ui-inspector -p ui-inspector-svelte-example --features ui-inspector-svelte-example/e2e",
    "e2e:run": "wdio run ./wdio.conf.ts",
    "e2e:web": "vite --mode e2e --host 127.0.0.1 --port 1420",
    "format": "prettier --check src *.html *.json *.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tauri-ui-inspector/adapter-svelte": "workspace:*",
    "@tauri-ui-inspector/inspector": "workspace:*",
    "svelte": "^5.56.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wdio/cli": "^9.31.1",
    "@wdio/globals": "^9.31.1",
    "@wdio/local-runner": "^9.31.1",
    "@wdio/mocha-framework": "^9.31.1",
    "@wdio/spec-reporter": "^9.31.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "image-size": "^2.0.2",
    "pngjs": "^7.0.0",
    "start-server-and-test": "^3.0.12",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webdriverio": "^9.31.1"
  }
}

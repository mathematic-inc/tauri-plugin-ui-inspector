{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UI Inspector Fixture",
  "version": "0.1.0",
  "identifier": "dev.ui-inspector.fixture",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UI Inspector Fixture",
        "x": 100,
        "y": 100,
        "width": 1280,
        "height": 832,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}

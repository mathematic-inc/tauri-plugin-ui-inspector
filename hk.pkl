amends ".hk/org.pkl"

exclude =
  super.exclude
    + List(
      "**/.svelte-check/**",
      "**/permissions/**",
      "docs/mockups/fixture-idle.png",
      "docs/mockups/fixture-inspecting.png",
    )

local rustFiles = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml", "**/*.rs")
local nodeFiles =
  List(
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "packages/*/**",
    "examples/*/**",
  )
local slow = List("slow")

steps {
  ["trailing-whitespace"] {
    depends = "newlines"
  }
  // oxfmt reads `svelte` from `node_modules`, so it runs through pnpm.
  ["oxfmt"] {
    check = "pnpm exec oxfmt --check {{ files }}"
    check_diff = "pnpm exec oxfmt --check {{ files }}"
    fix = "pnpm exec oxfmt --write {{ files }}"
  }
  // oxlint reads the types of each workspace package from its `dist` folder.
  ["packages-build"] {
    glob = nodeFiles
    check = "pnpm --workspace-concurrency=1 --filter './packages/*' build"
  }
  ["oxlint"] {
    depends = List("oxfmt", "packages-build")
  }
  ["typecheck"] {
    glob = nodeFiles
    check = "pnpm check"
    depends = List("trailing-whitespace", "packages-build")
    profiles = slow
  }
  ["vitest"] {
    glob = nodeFiles
    check = "pnpm test"
    depends = "typecheck"
    profiles = slow
  }
  ["frontend-build"] {
    glob = nodeFiles + rustFiles
    check = "pnpm --filter @tauri-ui-inspector/example-svelte-tauri build:web"
    depends = "typecheck"
    profiles = slow
  }
  ["e2e"] {
    glob = nodeFiles
    check = new Script {
      windows = "pnpm e2e"
      other =
        "if [ \"$(uname -s)\" = Darwin ]; then pnpm e2e; else echo 'Native E2E requires macOS or Windows'; fi"
    }
    depends = "vitest"
    profiles = slow
  }
  ["cargo-lockfile"] {
    glob = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml")
    check = "cargo metadata --locked --format-version 1 --all-features > /dev/null"
    profiles = slow
  }
  ["cargo-clippy"] {
    depends = "frontend-build"
  }
}

{
  "name": "tauri-plugin-ui-inspector-workspace",
  "private": true,
  "repository": "github:mathematic-inc/tauri-plugin-ui-inspector",
  "license": "MIT OR Apache-2.0",
  "author": "Mathematic, Inc.",
  "type": "module",
  "scripts": {
    "build": "pnpm --workspace-concurrency=1 -r build",
    "check": "pnpm --workspace-concurrency=1 -r check",
    "dev": "pnpm --filter @tauri-ui-inspector/example-svelte-tauri dev",
    "e2e": "pnpm --filter @tauri-ui-inspector/example-svelte-tauri e2e",
    "fix": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings .",
    "prepare": "if [ -z \"$CI\" ] && command -v hk >/dev/null 2>&1; then hk install; fi",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "oxfmt": "^0.77.0",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}

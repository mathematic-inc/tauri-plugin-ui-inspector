{
  "name": "tauri-plugin-ui-inspector-workspace",
  "private": true,
  "repository": "github:mathematic-inc/tauri-plugin-ui-inspector",
  "license": "MIT OR Apache-2.0",
  "author": "Randolf Jung <randolf@sloper.ai>",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "dev": "pnpm --filter @tauri-ui-inspector/example-svelte-tauri dev",
    "e2e": "pnpm --filter @tauri-ui-inspector/example-svelte-tauri e2e",
    "fix": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings .",
    "prepare": "if [ -z \"$CI\" ] && command -v hk >/dev/null 2>&1; then hk install; fi",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "svelte": "^5.56.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=26"
  }
}

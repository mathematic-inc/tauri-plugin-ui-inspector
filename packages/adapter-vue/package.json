{
  "name": "@tauri-ui-inspector/adapter-vue",
  "version": "0.1.2",
  "description": "Vue 3 development metadata adapter for tauri-plugin-ui-inspector.",
  "keywords": [
    "agent",
    "inspector",
    "tauri",
    "ui",
    "vue"
  ],
  "homepage": "https://github.com/mathematic-inc/tauri-plugin-ui-inspector#readme",
  "bugs": "https://github.com/mathematic-inc/tauri-plugin-ui-inspector/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathematic-inc/tauri-plugin-ui-inspector.git",
    "directory": "packages/adapter-vue"
  },
  "license": "MIT OR Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @tauri-ui-inspector/inspector build",
    "build": "tsc -p tsconfig.json",
    "precheck": "pnpm --filter @tauri-ui-inspector/inspector build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-ui-inspector/inspector": "workspace:*",
    "element-source": "^0.0.5"
  },
  "devDependencies": {
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "vue": ">=3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

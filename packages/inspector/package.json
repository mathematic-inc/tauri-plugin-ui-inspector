{
  "name": "@tauri-ui-inspector/inspector",
  "version": "0.1.0",
  "description": "Framework-neutral DOM metadata and Tauri bridge for tauri-plugin-ui-inspector.",
  "keywords": [
    "agent",
    "inspector",
    "tauri",
    "testing",
    "ui"
  ],
  "homepage": "https://github.com/mathematic-inc/tauri-plugin-ui-inspector#readme",
  "bugs": "https://github.com/mathematic-inc/tauri-plugin-ui-inspector/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathematic-inc/tauri-plugin-ui-inspector.git",
    "directory": "packages/inspector"
  },
  "license": "MIT OR Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @tauri-ui-inspector/shared build",
    "build": "tsc -p tsconfig.json",
    "precheck": "pnpm --filter @tauri-ui-inspector/shared build",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@medv/finder": "^4.0.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-ui-inspector/shared": "workspace:*",
    "dom-accessibility-api": "^0.7.1"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  }
}
